# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=
# Channel ID(s) of the guild-chat channel, comma separated. Empty = all channels.
CHANNEL_IDS=
# Wowhead section: forever, classic, tbc ... (empty = retail)
WOWHEAD_VERSION=forever
# Optional: post via this webhook instead of replying (for WoW-linked channels)
WEBHOOK_URL=
# Optional: or post into this other channel, with a link back to the message
OUTPUT_CHANNEL_ID=
